// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  LOCAL_CONTRACTOR
  FOREIGN_CONTRACTOR
  SKILLED_WORKER
  SITE_SUPERVISOR
}

model UserExternal {
  id             String      @id @default(uuid())
  nationalId     String      @unique   // National ID / Passport No.
  fullName       String
  accountType    AccountType
  companyName    String?               // required only for contractor account types
  mobileNumber   String
  email          String      @unique
  password       String                // bcrypt hash, never stored plain
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  applications ContractorCompany[]
}


enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
}


model RegnoCounter {
  year  Int @id
  count Int @default(0)
}


model BrsCompanyRecord {
  id                         String   @id @default(uuid())
  registrationNumber         String   @unique
  businessName               String
  kraPin                     String
  registrationDate           String
  foreignShareholdingPercent Int
  fetchedAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  directors                  BrsDirectorRecord[]
}

model BrsDirectorRecord {
  id              String   @id @default(uuid())
  companyRecordId String
  companyRecord   BrsCompanyRecord @relation(fields: [companyRecordId], references: [id], onDelete: Cascade)
  idNo            String
  fullNames       String
  nationality     String
  percentageShare String
  createdAt       DateTime @default(now())

  @@unique([companyRecordId, idNo])
}

model ContractorCompany {
  regno     String   @id
  userId    String
  user      UserExternal @relation(fields: [userId], references: [id])
  directors ContractorDirector[]
  offices   ContractorOffice[]
  documents ContractorDocument[]
  referees ContractorReferee[]
  assets ContractorAsset[]
  staff ContractorStaff[]
  equipment ContractorEquipment[]
  projectExperience ContractorProjectExperience[]
  litigationHistory ContractorLitigation[]
  classification ContractorClassification?
  applications ContractorApplication[]
  
  // Step 1: Firm Profile
  incorporationNo String
  firmName        String?
  headOffice      String
  postalAddress   String?
  county          String?
  town            String
  localForeign    String
  website         String?
  telephone       String
  cellPhone       String
  email           String?
  latitude        String?
  longitude       String?

  // Step 2: Firm Registration
  firmType                String?
  kraPin                  String?
  registeredCapital       String?
  paidUpCapital           String?
  taxComplianceNo         String?
  bankName                String?
  bankBranch              String?
  agencyName              String?
  agencyRegistrationNo    String?
  agencyYear              String?
  associationName         String?
  associationNameOther    String?
  associationMembershipNo String?
  jointVentureProjects    String?
  jointVentureFirms       String?
  hasAgpoCertificate      String?
  agpoCategories          String[]
  agpoExpiryDate          String?

  // Step 3: Declarations
  acceptCodeOfConduct Boolean @default(false)
  acceptTerms         Boolean @default(false)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ContractorDirector {
  id                   String   @id @default(uuid())
  regno                String
  company              ContractorCompany @relation(fields: [regno], references: [regno])
  idNo                 String
  fullNames            String
  nationality          String
  highestQualification String
  profession           String
  yearsOfExperience    String
  percentageShare      String
  cvFileName           String?
  cvFileKey            String?
  academicCertFileName String?
  academicCertFileKey  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ContractorOffice {
  id        String   @id @default(uuid())
  regno     String
  company   ContractorCompany @relation(fields: [regno], references: [regno])
  town      String
  address   String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractorDocument {
  id         String   @id @default(uuid())
  regno      String
  company    ContractorCompany @relation(fields: [regno], references: [regno])
  docType    String
  fileName   String
  fileKey    String
  uploadedAt DateTime @default(now())
}
model ContractorReferee {
  id            String   @id @default(uuid())
  regno         String
  company       ContractorCompany @relation(fields: [regno], references: [regno])
  name          String
  postalAddress String
  telephone     String
  profession    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model ContractorAsset {
  id             String   @id @default(uuid())
  regno          String
  company        ContractorCompany @relation(fields: [regno], references: [regno])
  description    String
  registrationNo String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContractorStaff {
  id                   String   @id @default(uuid())
  regno                String
  company              ContractorCompany @relation(fields: [regno], references: [regno])
  fullNames            String
  idNo                 String
  nationality          String
  highestQualification String
  yearsOfExperience    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}


model ContractorEquipment {
  id             String   @id @default(uuid())
  regno          String
  company        ContractorCompany @relation(fields: [regno], references: [regno])
  name           String
  ownedOrLeased  String
  typeMakeModel  String
  category       String
  registrationNo String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContractorProjectExperience {
  id                String   @id @default(uuid())
  regno             String
  company           ContractorCompany @relation(fields: [regno], references: [regno])
  project           String
  ncaProjectRegNo   String
  contractSum       String
  contractPeriod    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContractorLitigation {
  id                  String   @id @default(uuid())
  regno               String
  company             ContractorCompany @relation(fields: [regno], references: [regno])
  refNo               String
  date                String
  partiesInvolved     String
  particularOfLitigation String
  statusOfMatter      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
model ContractorClassification {
  regno                String   @id
  company              ContractorCompany @relation(fields: [regno], references: [regno])
  applicationType      String
  buildingWorksCategory String
  roadWorksCategory    String
  waterWorksCategory   String
  electricalSubClasses String[]
  electricalCategory   String
  mechanicalSubClasses String[]
  mechanicalCategory   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ContractorApplication {
  id              String   @id @default(uuid())
  regno           String
  company         ContractorCompany @relation(fields: [regno], references: [regno])
  trackNo         String
  companyName     String?
  classesApplied  String
  applicationType String
  localForeign    String
  status          String   @default("SUBMITTED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}